# ── AGNITE Backend Configuration ──────────────────────────────────────
# Copy this file to .env and fill in the values.
# Private credentials must NEVER reach the React frontend.

APP_ENV=development
APP_VERSION=0.1.0

# ── Database ──────────────────────────────────────────────────────────
# SQLite for local dev, PostgreSQL / Supabase for deployment.
DATABASE_URL=sqlite:///./agnite.db

# ── Frontend ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── NASA FIRMS ────────────────────────────────────────────────────────
# Phase 1 uses public CSV downloads (no key required).
# Set this for future Area API migration.
NASA_FIRMS_MAP_KEY=
NASA_CACHE_TTL_SECONDS=600

# ── ML / Models ───────────────────────────────────────────────────────
ENABLE_ML_CLASSIFIER=false
ENABLE_RECURRENCE_MODEL=false

# ── LLM / AGNITE AI ──────────────────────────────────────────────────
ENABLE_LLM=false
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ── Background Jobs ──────────────────────────────────────────────────
ENABLE_BACKGROUND_JOBS=false

# ── Redis (optional, for future caching layer) ───────────────────────
REDIS_URL=
